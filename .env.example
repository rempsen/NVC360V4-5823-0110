# NVC360 — environment template.
#
# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored (as is .env.*, with this file the only exception).
#
# This file is the documented contract of what the server needs at runtime.
# It is also the key list injected into the staging container from AWS Secrets
# Manager — see infra/terraform/staging/service.tf.
#
# NEVER commit real values. NEVER copy production credentials into a dev .env.

# --- Core ------------------------------------------------------------------
NODE_ENV=development
PORT=4200
APP_URL=http://localhost:4200
WEBSITE_URL=http://localhost:4200

# --- Database --------------------------------------------------------------
# Turso (libSQL) today. Postgres is the Phase D migration target.
# WARNING: a dev .env has historically pointed at the PRODUCTION Turso
# database. Do not do that. Use a staging/dev database.
DATABASE_URL=libsql://your-database.turso.io
DATABASE_AUTH_TOKEN=

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Object storage --------------------------------------------------------
# S3 wire protocol via Bun.S3Client. Production uses Tigris (t3.storage.dev);
# staging on AWS uses real S3, where S3_ENDPOINT is left UNSET and credentials
# come from the ECS task role instead of these keys.
# Do NOT add the AWS SDK server-side — it OOM'd the deploy bundler.
S3_ENDPOINT=https://t3.storage.dev
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Realtime / rate limiting ---------------------------------------------
# Unset = in-memory single-node fallback. Set = Redis multi-node path.
# docker compose provides redis://redis:6379 locally.
REDIS_URL=

# --- Payments --------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Currently UNSET in production, which means webhook signatures are not being
# verified. Get this from the Stripe dashboard webhook endpoint and set it.
STRIPE_WEBHOOK_SECRET=
AUTUMN_SECRET_KEY=

# --- Messaging / email ----------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
# Prefer a scoped Twilio API key over the account SID + auth token pair.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Maps ------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# --- AI gateway -----------------------------------------------------------
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=

# --- Observability --------------------------------------------------------
SENTRY_DSN=
# Enable per-tenant error alerting by setting either of these.
ALERT_EMAIL=
ALERT_WEBHOOK_URL=

# --- Runable platform (production hosting only) ---------------------------
APPLICATION_ID=
RUNABLE_AUTH_ISSUER=
RUNABLE_URL=

# --- Build-time (Vite inlines these into the client bundle) ---------------
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=development
VITE_APPLICATION_ID=
VITE_RUNABLE_AUTH_ISSUER=
